tmux/.config/tmux/plugins
zsh/.personalrc
wallpapers/Pictures/Wallpapers/.nextcloudsync.log
wallpapers/Pictures/Wallpapers/.sync_*
gtk3/.config/gtk-3.0/bookmarks

# matugen writes these from the palette (see matugen/.config/matugen/config.toml)
gtk3/.local/share/themes/HyprPunk/gtk-3.0/colors.css
gtk4/.config/gtk-4.0/gtk.css
kvantum/.config/Kvantum/HyprPunk/
bat/.config/bat/themes/
btop/.config/btop/themes/
yazi/.config/yazi/theme.toml
fastfetch/.config/fastfetch/config.jsonc

# Your own tmux and kitty settings, read by their configs
tmux/.config/tmux/personal.conf
kitty/.config/kitty/personal.conf

# btop rewrites its settings whenever you change one in its interface. The repo keeps
# btop.default.conf instead, copied in at install
btop/.config/btop/btop.conf

# cava puts its stock shaders and themes back on every launch
cava/.config/cava/shaders/
cava/.config/cava/themes/

# dolphin create .directory files to change some options
**/.directory
