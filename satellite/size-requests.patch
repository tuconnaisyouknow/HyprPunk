+    /// A maximized or fullscreen toplevel has the size the compositor configured, which
+    /// the X client can't change (xdg-shell makes that size mandatory)
+    pub fn can_change_size(&self, window: x::Window) -> bool {
+        let Some(data) = self
+            .windows
+            .get(&window)
+            .copied()
+            .and_then(|id| self.world.entity(id).ok())
+        else {
+            return true;
+        };
+
+        match data.get::<&SurfaceRole>().as_deref() {
+            Some(SurfaceRole::Toplevel(Some(toplevel))) => {
+                !(toplevel.fullscreen || toplevel.maximized)
+            }
+            _ => true,
+        }
+    }
