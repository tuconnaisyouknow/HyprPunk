+    fn send_current_geometry(&self, window: x::Window) {
+        let cookie = self.connection.send_request(&x::GetGeometry {
+            drawable: x::Drawable::Window(window),
+        });
+        let geometry = unwrap_or_skip_bad_window_ret!(self.connection.wait_for_reply(cookie));
+        let event = &x::ConfigureNotifyEvent::new(
+            window,
+            window,
+            x::WINDOW_NONE,
+            geometry.x(),
+            geometry.y(),
+            geometry.width(),
+            geometry.height(),
+            geometry.border_width(),
+            false,
+        );
+        unwrap_or_skip_bad_window_ret!(self.connection.send_and_check_request(&x::SendEvent {
+            destination: x::SendEventDest::Window(window),
+            propagate: false,
+            event_mask: x::EventMask::STRUCTURE_NOTIFY,
+            event,
+        }));
+    }
