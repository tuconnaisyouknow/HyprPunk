#!/bin/sh
# Stops the batteries charging past a limit, to make them last longer.
# Works on any battery whose driver offers one (charge_control_end_threshold).
#
#   battery-limit get      prints "<limit> <writable: 1 or 0> <saved limit>"
#   battery-limit set <N>  saves N (1 to 100, 100 for no limit) and applies it
#   battery-limit apply    as root, at boot and after sleep: opens the limit to the
#                          wheel group and puts the saved one back, as firmwares forget it
#
# The control center calls get and set, as a regular user of the wheel group.

kept=/var/lib/battery-limit/end_threshold

batteries() {
  for dir in /sys/class/power_supply/*; do
    [ -e "$dir/charge_control_end_threshold" ] && echo "$dir"
  done
}

# Some firmwares (ThinkPad, Framework…) refuse a limit below the point where charging
# starts again, so that one is lowered first
apply_limit() {
  status=0
  for dir in $(batteries); do
    start="$dir/charge_control_start_threshold"
    if [ -e "$start" ] && [ "$(cat "$start")" -ge "$1" ]; then
      echo $(($1 > 5 ? $1 - 5 : 0)) >"$start" 2>/dev/null || status=1
    fi
    echo "$1" >"$dir/charge_control_end_threshold" 2>/dev/null || status=1
  done
  [ "$status" -eq 0 ] || echo "This battery does not accept a charge limit of $1 %." >&2
  return "$status"
}

case "$1" in
get)
  dir=$(batteries | head -n 1)
  [ -n "$dir" ] || exit 0
  file="$dir/charge_control_end_threshold"
  [ -w "$file" ] && [ -w "$kept" ] && writable=1 || writable=0
  echo "$(cat "$file") $writable $(cat "$kept" 2>/dev/null)"
  ;;
set)
  case "$2" in
  '' | *[!0-9]*) echo "Usage: battery-limit set <1-100>" >&2; exit 2 ;;
  esac
  if [ "$2" -lt 1 ] || [ "$2" -gt 100 ]; then
    echo "Usage: battery-limit set <1-100>" >&2
    exit 2
  fi
  echo "$2" >"$kept" || exit 1
  apply_limit "$2"
  ;;
apply)
  # Done here rather than in a udev rule: some drivers (asus-wmi…) add the limit
  # after the battery shows up, with no event to catch
  for dir in $(batteries); do
    for file in "$dir/charge_control_end_threshold" "$dir/charge_control_start_threshold"; do
      [ -e "$file" ] && chgrp wheel "$file" && chmod 0664 "$file"
    done
  done
  limit=$(cat "$kept" 2>/dev/null)
  # Nothing chosen yet, leave the firmware's own
  [ -n "$limit" ] || exit 0
  apply_limit "$limit"
  ;;
*)
  echo "Usage: battery-limit get | set <1-100> | apply" >&2
  exit 2
  ;;
esac
