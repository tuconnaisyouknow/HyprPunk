// Lets the user of an active local session change the system keymap (the login
// screen's and the TTYs') without a password, as keyboard-layoutctl.sh does when the
// layout changes. Nothing else of localectl: the locale and the rest still ask.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.locale1.set-keyboard" && subject.local && subject.active)
        return polkit.Result.YES;
});
