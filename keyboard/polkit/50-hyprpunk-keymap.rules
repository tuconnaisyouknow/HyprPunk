// When you switch layout, keyboard-layoutctl.sh also sets it for the login screen
// and the TTYs. This lets it do so without a password, for whoever is sitting at the
// machine. Only the keymap: the rest of localectl still asks.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.locale1.set-keyboard" && subject.local && subject.active)
        return polkit.Result.YES;
});
