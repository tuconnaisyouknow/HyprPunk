# Vi mode, with Alt+Backspace still deleting a whole word
bindkey -v
bindkey -M viins '^[^?' backward-kill-word
bindkey -M viins '^[^H' backward-kill-word

# The four Vim keys in normal and visual mode, on Vim's letters or on the home row
# (j k l m on AZERTY). .zshrc reads them before loading this file. A letter the move left
# free takes what the key the arrows landed on did, read before anything is rebound.
() {
  local name key widget
  local -A keys taken
  # bindkey reads ^ and \ as the start of a code: escaped, they're typed as they are
  for name key in "${(@kv)vim_keys}"; do
    key=${key//'\'/'\\'}
    keys[$name]=${key//'^'/'\^'}
  done
  for name in ${(k)keys[(I)spare_*]}; do
    taken[${name#spare_}]=${"$(bindkey -M vicmd -- "$keys[$name]")"##* }
  done
  for name widget in left backward-char down down-line-or-history up up-line-or-history right forward-char; do
    bindkey -M vicmd -- "$keys[$name]" $widget
    bindkey -M visual -- "$keys[$name]" $widget
  done
  for key widget in "${(@kv)taken}"; do
    bindkey -M vicmd -- $key $widget
  done
}

# Ctrl+Space takes the suggestion, Alt+L and Alt+K go through the history
# of what starts like the current line
bindkey -r '^ '
bindkey -r '^[l'
bindkey -r '^[k'
bindkey '^ ' autosuggest-accept
bindkey '^[l' history-beginning-search-backward
bindkey '^[k' history-beginning-search-forward
