# YAY config
alias i='yay -S --needed --noconfirm --removemake'
alias u='yay -Syu --noconfirm --removemake'
alias update='yay -Sy --needed --noconfirm --removemake'
alias r='yay -Rns --noconfirm --removemake'

# SUDO config (keep user config en variable)
alias sudo='sudo -E '
alias sudoi='command sudo -i'

# EZA config
alias ls='eza --color=always --icons=always'
alias tree='eza --color=always --icons=always --tree'

# NVIM config
alias vim='nvim'

# FASTFETCH config
alias ff='fastfetch'

# TMUX config
alias t='tmux'

# YAZI config
alias y='yazi'

# BAT config
alias rcat='\cat'
