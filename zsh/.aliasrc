# HyprPunk's aliases, loaded by .zshrc. Yours go in ~/.personalrc, read after this
# file, so you can also redefine any of these there.

# Packages, through yay, which asks before it changes anything. What's already there
# isn't installed again, and the build dependencies go once a package is built.
alias i='yay -S --needed --removemake'     # Install
alias u='yay -Syu --removemake'            # Update everything
alias r='yay -Rns'                         # Remove, with what it pulled in

# sudo keeps your environment (and your aliases, thanks to the trailing space)
alias sudo='sudo -E '
alias sudoi='command sudo -i'

# ls and tree, with colors and icons in the terminal but plain names when piped,
# so grep and friends don't trip on the escape codes
alias ls='eza --color=auto --icons=auto'
alias tree='eza --color=auto --icons=auto --tree'

# Short names
alias vim='nvim'
alias ff='fastfetch'
alias t='tmux'
alias y='yazi'

# zsh-bat turns cat into bat, rcat is the real one
alias rcat='\cat'
