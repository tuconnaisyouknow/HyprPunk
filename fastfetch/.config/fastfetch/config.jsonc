// The system summary that greets every new terminal outside tmux, with a logo drawn
// by kitty and one line per part of the machine: the hardware in the accent, the
// software in the secondary color. Both are slots of kitty's palette (magenta and 147)
// rather than fixed colors, so a summary already on screen follows the wallpaper.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-icat",
    "source": "~/.config/fastfetch/logos/*",
    "width": 31,
  },
  "display": {
    "separator": " ❯ ",
    "color": {
      "title": "magenta",
      "keys": "magenta"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "┌─────────────────────────Hardware─────────────────────────┐",
      "outputColor": "magenta"
    },
    {
      "type": "host",
      "key": " PC",
      "keyColor": "magenta",
      "outputColor": "magenta"
    },
    {
      "type": "cpu",
      "key": "│ ├ ",
      "keyColor": "magenta",
      "outputColor": "magenta"
    },
    {
      "type": "gpu",
      "key": "│ ├󰢮 ",
      "keyColor": "magenta",
      "outputColor": "magenta"
    },
    {
      "type": "memory",
      "key": "│ ├ ",
      "keyColor": "magenta",
      "outputColor": "magenta"
    },
    {
      "type": "swap",
      "key": "│ ├ ",
      "keyColor": "magenta",
      "outputColor": "magenta"
    },
    {
      "type": "disk",
      "key": "└ └ ",
      "keyColor": "magenta",
      "outputColor": "magenta"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────────────────────┘",
      "outputColor": "magenta"
    },
    "break",
    {
      "type": "custom",
      "format": "┌─────────────────────────Software─────────────────────────┐",
      "outputColor": "38;5;147"
    },
    {
      "type": "os",
      "key": "󰣇 OS",
      "keyColor": "38;5;147",
      "outputColor": "38;5;147"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖 ",
      "keyColor": "38;5;147",
      "outputColor": "38;5;147"
    },
    {
      "type": "shell",
      "key": "│ ├ ",
      "keyColor": "38;5;147",
      "outputColor": "38;5;147"
    },
    {
      "type": "terminal",
      "key": "│ ├ ",
      "keyColor": "38;5;147",
      "outputColor": "38;5;147"
    },
    {
      "type": "lm",
      "key": "│ ├ ",
      "keyColor": "38;5;147",
      "outputColor": "38;5;147"
    },
    {
      "type": "wm",
      "key": "└ └ ",
      "keyColor": "38;5;147",
      "outputColor": "38;5;147"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────────────────────┘",
      "outputColor": "38;5;147"
    },
  ]
}
