// The system summary that greets every new terminal outside tmux, with a logo drawn
// by kitty and one line per part of the machine: the hardware in the accent, the
// software in the secondary color. matugen writes it to ~/.config/fastfetch/config.jsonc
// in the wallpaper's palette.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-icat",
    "source": "~/.config/fastfetch/logos/*",
    "width": 31,
  },
  "display": {
    "separator": " ❯ ",
    "color": {
      "title": "38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}",
      "keys": "38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "┌─────────────────────────Hardware─────────────────────────┐",
      "outputColor": "38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}"
    },
    {
      "type": "host",
      "key": " PC",
      "keyColor": "38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}",
      "outputColor": "38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}"
    },
    {
      "type": "cpu",
      "key": "│ ├ ",
      "keyColor": "38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}",
      "outputColor": "38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}"
    },
    {
      "type": "gpu",
      "key": "│ ├󰢮 ",
      "keyColor": "38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}",
      "outputColor": "38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}"
    },
    {
      "type": "memory",
      "key": "│ ├ ",
      "keyColor": "38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}",
      "outputColor": "38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}"
    },
    {
      "type": "swap",
      "key": "│ ├ ",
      "keyColor": "38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}",
      "outputColor": "38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}"
    },
    {
      "type": "disk",
      "key": "└ └ ",
      "keyColor": "38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}",
      "outputColor": "38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────────────────────┘",
      "outputColor": "38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}"
    },
    "break",
    {
      "type": "custom",
      "format": "┌─────────────────────────Software─────────────────────────┐",
      "outputColor": "38;2;{{colors.secondary.default.red}};{{colors.secondary.default.green}};{{colors.secondary.default.blue}}"
    },
    {
      "type": "os",
      "key": "󰣇 OS",
      "keyColor": "38;2;{{colors.secondary.default.red}};{{colors.secondary.default.green}};{{colors.secondary.default.blue}}",
      "outputColor": "38;2;{{colors.secondary.default.red}};{{colors.secondary.default.green}};{{colors.secondary.default.blue}}"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖 ",
      "keyColor": "38;2;{{colors.secondary.default.red}};{{colors.secondary.default.green}};{{colors.secondary.default.blue}}",
      "outputColor": "38;2;{{colors.secondary.default.red}};{{colors.secondary.default.green}};{{colors.secondary.default.blue}}"
    },
    {
      "type": "shell",
      "key": "│ ├ ",
      "keyColor": "38;2;{{colors.secondary.default.red}};{{colors.secondary.default.green}};{{colors.secondary.default.blue}}",
      "outputColor": "38;2;{{colors.secondary.default.red}};{{colors.secondary.default.green}};{{colors.secondary.default.blue}}"
    },
    {
      "type": "terminal",
      "key": "│ ├ ",
      "keyColor": "38;2;{{colors.secondary.default.red}};{{colors.secondary.default.green}};{{colors.secondary.default.blue}}",
      "outputColor": "38;2;{{colors.secondary.default.red}};{{colors.secondary.default.green}};{{colors.secondary.default.blue}}"
    },
    {
      "type": "lm",
      "key": "│ ├ ",
      "keyColor": "38;2;{{colors.secondary.default.red}};{{colors.secondary.default.green}};{{colors.secondary.default.blue}}",
      "outputColor": "38;2;{{colors.secondary.default.red}};{{colors.secondary.default.green}};{{colors.secondary.default.blue}}"
    },
    {
      "type": "wm",
      "key": "└ └ ",
      "keyColor": "38;2;{{colors.secondary.default.red}};{{colors.secondary.default.green}};{{colors.secondary.default.blue}}",
      "outputColor": "38;2;{{colors.secondary.default.red}};{{colors.secondary.default.green}};{{colors.secondary.default.blue}}"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────────────────────┘",
      "outputColor": "38;2;{{colors.secondary.default.red}};{{colors.secondary.default.green}};{{colors.secondary.default.blue}}"
    },
  ]
}
