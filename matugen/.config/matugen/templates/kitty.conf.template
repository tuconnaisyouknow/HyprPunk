# vim:ft=kitty
# kitty's colors from the wallpaper's palette. matugen writes them to
# ~/.local/state/hyprpunk/kitty-colors.conf, which kitty.conf includes, and kitty reads
# them again when wallpaperctl.sh tells it. The sixteen colors keep the names terminal
# tools ask for them by, and get the role closest to each: tools say errors and changes in
# red, green, yellow and blue, so those are the fixed colors (meanings.json).

########
# TEXT #
########

foreground           {{colors.text.default.hex}}
background           {{colors.surface.default.hex}}
selection_foreground {{colors.on_primary.default.hex}}
selection_background {{colors.secondary.default.hex}}

# The cursor and the links in the accent, like what you type and point at in the shell
cursor            {{colors.primary.default.hex}}
cursor_text_color {{colors.on_primary.default.hex}}
url_color         {{colors.primary.default.hex}}

##################
# WINDOWS & TABS #
##################

active_border_color   {{colors.secondary.default.hex}}
inactive_border_color {{colors.overlay0.default.hex}}
bell_border_color     {{colors.yellow.default.hex}}
wayland_titlebar_color system

# The tab you're on is lit in the accent, the others sit on the bar
active_tab_foreground   {{colors.on_primary.default.hex}}
active_tab_background   {{colors.primary.default.hex}}
inactive_tab_foreground {{colors.secondary.default.hex}}
inactive_tab_background {{colors.surface_container_low.default.hex}}
tab_bar_background      {{colors.surface_container_lowest.default.hex}}

#########
# MARKS #
#########

mark1_foreground {{colors.on_primary.default.hex}}
mark1_background {{colors.secondary.default.hex}}
mark2_foreground {{colors.on_primary.default.hex}}
mark2_background {{colors.tone_pink.default.hex}}
mark3_foreground {{colors.on_primary.default.hex}}
mark3_background {{colors.tone_blue.default.hex}}

#######################
# THE TERMINAL COLORS #
#######################

# Black: the raised surfaces
color0 {{colors.surface_container_high.default.hex}}
color8 {{colors.surface_container_highest.default.hex}}

# Red: the error
color1 {{colors.error.default.hex}}
color9 {{colors.error.default.hex}}

# Green, yellow and blue: the fixed ones
color2  {{colors.green.default.hex}}
color10 {{colors.green.default.hex}}

color3  {{colors.yellow.default.hex}}
color11 {{colors.yellow.default.hex}}

color4  {{colors.blue.default.hex}}
color12 {{colors.blue.default.hex}}

# Magenta: the accent
color5  {{colors.primary.default.hex}}
color13 {{colors.primary.default.hex}}

# Cyan: the palette's cyan tone
color6  {{colors.tone_cyan.default.hex}}
color14 {{colors.tone_cyan.default.hex}}

# White: the text ramp
color7  {{colors.subtext1.default.hex}}
color15 {{colors.subtext0.default.hex}}

# The secondary, in the 256 colors' 147: what's drawn in it (fastfetch) follows the
# wallpaper while on screen, like what's drawn in the accent
color147 {{colors.secondary.default.hex}}
