# The window borders' and glow's color, the palette's accent as bare hex so Hyprland can
# add its own alpha, and the wallpaper's theme, since only neon glows. matugen writes it
# from ~/.config/matugen/templates/hyprland.template, and Hyprland's accent.lua reads it.
primary={{colors.primary.default.hex_stripped}}
theme={{theme}}
