# btop's colors from the wallpaper's palette. matugen writes them to
# ~/.config/btop/themes/hyprpunk.theme, which btop.conf picks, and open btops take them
# when wallpaperctl.sh tells them. The accent and the secondary lead; each graph runs
# through the palette's tones toward one of them. The temperature takes the fixed green,
# yellow and red (meanings.json), which say how hot it runs.

# The terminal's background, so btop sits in it like everything else
theme[main_bg]="{{colors.surface.default.hex}}"
theme[main_fg]="{{colors.text.default.hex}}"
theme[title]="{{colors.primary.default.hex}}"
theme[inactive_fg]="{{colors.overlay1.default.hex}}"
theme[div_line]="{{colors.overlay0.default.hex}}"
theme[meter_bg]="{{colors.surface_container_high.default.hex}}"

# The keys you press and the process you're on, in the accent
theme[hi_fg]="{{colors.primary.default.hex}}"
theme[selected_bg]="{{colors.surface_container_high.default.hex}}"
theme[selected_fg]="{{colors.primary.default.hex}}"

# What's written over the graphs and the processes' details
theme[graph_text]="{{colors.secondary.default.hex}}"
theme[proc_misc]="{{colors.secondary.default.hex}}"

# The boxes' outlines
theme[cpu_box]="{{colors.primary.default.hex}}"
theme[mem_box]="{{colors.secondary.default.hex}}"
theme[net_box]="{{colors.tone_cyan.default.hex}}"
theme[proc_box]="{{colors.tone_blue.default.hex}}"

theme[temp_start]="{{colors.green.default.hex}}"
theme[temp_mid]="{{colors.yellow.default.hex}}"
theme[temp_end]="{{colors.error.default.hex}}"

theme[cpu_start]="{{colors.tone_teal.default.hex}}"
theme[cpu_mid]="{{colors.tone_cyan.default.hex}}"
theme[cpu_end]="{{colors.primary.default.hex}}"

theme[free_start]="{{colors.tone_cyan.default.hex}}"
theme[free_mid]="{{colors.tone_blue.default.hex}}"
theme[free_end]="{{colors.secondary.default.hex}}"

theme[cached_start]="{{colors.tone_blue.default.hex}}"
theme[cached_mid]="{{colors.tone_pink.default.hex}}"
theme[cached_end]="{{colors.secondary.default.hex}}"

theme[available_start]="{{colors.tone_yellow.default.hex}}"
theme[available_mid]="{{colors.tone_orange.default.hex}}"
theme[available_end]="{{colors.tone_red.default.hex}}"

theme[used_start]="{{colors.tone_green.default.hex}}"
theme[used_mid]="{{colors.tone_teal.default.hex}}"
theme[used_end]="{{colors.tone_cyan.default.hex}}"

theme[download_start]="{{colors.tone_orange.default.hex}}"
theme[download_mid]="{{colors.tone_red.default.hex}}"
theme[download_end]="{{colors.primary.default.hex}}"

theme[upload_start]="{{colors.tone_green.default.hex}}"
theme[upload_mid]="{{colors.tone_teal.default.hex}}"
theme[upload_end]="{{colors.secondary.default.hex}}"

theme[process_start]="{{colors.tone_blue.default.hex}}"
theme[process_mid]="{{colors.tone_pink.default.hex}}"
theme[process_end]="{{colors.primary.default.hex}}"
