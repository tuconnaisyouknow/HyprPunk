<?xml version="1.0" encoding="UTF-8"?>
<!-- The code's colors for bat and yazi's previews, the same as Neovim's hyprpunk
     colorscheme: the accent on keywords, the secondary on fields, the palette's tones on
     the rest, and the fixed colors (meanings.json) on diffs and errors. matugen writes it
     for yazi with every palette, and batctl.sh once per palette for bat. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>name</key>
    <string>HyprPunk</string>
    <key>uuid</key>
    <string>4c9f1d2e-8b7a-4e35-9a61-2f0d5c8e7b13</string>
    <key>colorSpaceName</key>
    <string>sRGB</string>
    <key>settings</key>
    <array>
      <dict>
        <key>settings</key>
        <dict>
          <key>background</key>
          <string>{{colors.surface.default.hex}}</string>
          <key>foreground</key>
          <string>{{colors.text.default.hex}}</string>
          <key>caret</key>
          <string>{{colors.primary.default.hex}}</string>
          <key>lineHighlight</key>
          <string>{{colors.surface_container.default.hex}}</string>
          <key>misspelling</key>
          <string>{{colors.error.default.hex}}</string>
          <key>accent</key>
          <string>{{colors.primary.default.hex}}</string>
          <key>selection</key>
          <string>{{colors.overlay2.default.hex}}40</string>
          <key>activeGuide</key>
          <string>{{colors.surface_container_high.default.hex}}</string>
          <key>findHighlight</key>
          <string>{{colors.surface_container_highest.default.hex}}</string>
          <key>gutterForeground</key>
          <string>{{colors.overlay1.default.hex}}</string>
        </dict>
      </dict>
      <!-- ############ -->
      <!-- # THE TEXT # -->
      <!-- ############ -->
      <!-- Comments -->
      <dict>
        <key>scope</key>
        <string>comment, punctuation.definition.comment</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{colors.overlay2.default.hex}}</string>
          <key>fontStyle</key>
          <string>italic</string>
        </dict>
      </dict>
      <!-- Punctuation -->
      <dict>
        <key>scope</key>
        <string>punctuation.separator, punctuation.terminator, punctuation.accessor, punctuation.section, punctuation.definition.parameters, punctuation.definition.arguments, punctuation.definition.tag, meta.brace</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{colors.overlay2.default.hex}}</string>
        </dict>
      </dict>
      <!-- Keywords, the accent -->
      <dict>
        <key>scope</key>
        <string>keyword, storage.type, storage.modifier, keyword.operator.word, keyword.operator.logical.python, keyword.operator.new, keyword.operator.expression</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{colors.primary.default.hex}}</string>
        </dict>
      </dict>
      <!-- Conditions read slanted -->
      <dict>
        <key>scope</key>
        <string>keyword.control.conditional</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{colors.primary.default.hex}}</string>
          <key>fontStyle</key>
          <string>italic</string>
        </dict>
      </dict>
      <!-- Fields, properties, modules and keys, the secondary -->
      <dict>
        <key>scope</key>
        <string>variable.other.member, variable.other.property, variable.other.object.property, meta.property-name, support.type.property-name, entity.name.namespace, entity.name.module, meta.mapping.key string, entity.name.tag.yaml</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{colors.secondary.default.hex}}</string>
        </dict>
      </dict>
      <!-- ############# -->
      <!-- # THE TONES # -->
      <!-- ############# -->
      <!-- Strings -->
      <dict>
        <key>scope</key>
        <string>string, punctuation.definition.string</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{colors.tone_green.default.hex}}</string>
        </dict>
      </dict>
      <!-- Escapes, regexes and interpolation -->
      <dict>
        <key>scope</key>
        <string>constant.character.escape, string.regexp, constant.other.placeholder, punctuation.section.interpolation, punctuation.definition.template-expression, meta.preprocessor, keyword.control.directive</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{colors.tone_pink.default.hex}}</string>
        </dict>
      </dict>
      <!-- Numbers and constants -->
      <dict>
        <key>scope</key>
        <string>constant.numeric, constant.language, constant.other, support.constant, variable.other.constant, support.function.builtin, meta.decorator, entity.name.function.decorator, punctuation.decorator, meta.annotation, variable.annotation, punctuation.definition.annotation</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{colors.tone_orange.default.hex}}</string>
        </dict>
      </dict>
      <!-- Characters, constructors and labels -->
      <dict>
        <key>scope</key>
        <string>constant.character, entity.name.function.constructor, entity.name.label</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{colors.tone_teal.default.hex}}</string>
        </dict>
      </dict>
      <!-- Operators -->
      <dict>
        <key>scope</key>
        <string>keyword.operator, storage.type.function.arrow</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{colors.tone_cyan.default.hex}}</string>
        </dict>
      </dict>
      <!-- Functions and tags -->
      <dict>
        <key>scope</key>
        <string>entity.name.function, support.function, variable.function, meta.function-call.generic, entity.name.tag</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{colors.tone_blue.default.hex}}</string>
        </dict>
      </dict>
      <!-- Types and attributes -->
      <dict>
        <key>scope</key>
        <string>entity.name.type, entity.name.class, support.type, support.class, entity.other.inherited-class, entity.other.attribute-name</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{colors.tone_yellow.default.hex}}</string>
        </dict>
      </dict>
      <!-- Parameters and self -->
      <dict>
        <key>scope</key>
        <string>variable.parameter, variable.language</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{colors.tone_red.default.hex}}</string>
        </dict>
      </dict>
      <!-- ########## -->
      <!-- # MARKUP # -->
      <!-- ########## -->
      <!-- Headings lead with the accent and the secondary, like Neovim's -->
      <dict>
        <key>scope</key>
        <string>markup.heading, markup.heading.1, heading.1</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{colors.primary.default.hex}}</string>
          <key>fontStyle</key>
          <string>bold</string>
        </dict>
      </dict>
      <dict>
        <key>scope</key>
        <string>markup.heading.2, heading.2</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{colors.secondary.default.hex}}</string>
          <key>fontStyle</key>
          <string>bold</string>
        </dict>
      </dict>
      <dict>
        <key>scope</key>
        <string>markup.heading.3, heading.3</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{colors.tone_red.default.hex}}</string>
          <key>fontStyle</key>
          <string>bold</string>
        </dict>
      </dict>
      <dict>
        <key>scope</key>
        <string>markup.heading.4, heading.4</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{colors.tone_orange.default.hex}}</string>
          <key>fontStyle</key>
          <string>bold</string>
        </dict>
      </dict>
      <dict>
        <key>scope</key>
        <string>markup.heading.5, heading.5</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{colors.tone_yellow.default.hex}}</string>
          <key>fontStyle</key>
          <string>bold</string>
        </dict>
      </dict>
      <dict>
        <key>scope</key>
        <string>markup.heading.6, heading.6</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{colors.tone_green.default.hex}}</string>
          <key>fontStyle</key>
          <string>bold</string>
        </dict>
      </dict>
      <!-- Emphasis -->
      <dict>
        <key>scope</key>
        <string>markup.bold</string>
        <key>settings</key>
        <dict>
          <key>fontStyle</key>
          <string>bold</string>
        </dict>
      </dict>
      <dict>
        <key>scope</key>
        <string>markup.italic</string>
        <key>settings</key>
        <dict>
          <key>fontStyle</key>
          <string>italic</string>
        </dict>
      </dict>
      <dict>
        <key>scope</key>
        <string>markup.strikethrough</string>
        <key>settings</key>
        <dict>
          <key>fontStyle</key>
          <string>strikethrough</string>
        </dict>
      </dict>
      <!-- Code and quotes -->
      <dict>
        <key>scope</key>
        <string>markup.raw, markup.inline.raw</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{colors.tone_green.default.hex}}</string>
        </dict>
      </dict>
      <dict>
        <key>scope</key>
        <string>markup.quote</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{colors.secondary.default.hex}}</string>
          <key>fontStyle</key>
          <string>italic</string>
        </dict>
      </dict>
      <!-- Links in the accent -->
      <dict>
        <key>scope</key>
        <string>markup.underline.link, string.other.link</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{colors.primary.default.hex}}</string>
          <key>fontStyle</key>
          <string>underline</string>
        </dict>
      </dict>
      <!-- List bullets -->
      <dict>
        <key>scope</key>
        <string>punctuation.definition.list, markup.list.numbered.bullet</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{colors.tone_teal.default.hex}}</string>
        </dict>
      </dict>
      <!-- ############ -->
      <!-- # MEANINGS # -->
      <!-- ############ -->
      <!-- Diffs and errors keep the fixed colors (meanings.json) -->
      <dict>
        <key>scope</key>
        <string>markup.inserted</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{colors.green.default.hex}}</string>
        </dict>
      </dict>
      <dict>
        <key>scope</key>
        <string>markup.deleted</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{colors.error.default.hex}}</string>
        </dict>
      </dict>
      <dict>
        <key>scope</key>
        <string>markup.changed</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{colors.yellow.default.hex}}</string>
        </dict>
      </dict>
      <dict>
        <key>scope</key>
        <string>meta.diff.header, meta.diff.range</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{colors.blue.default.hex}}</string>
        </dict>
      </dict>
      <dict>
        <key>scope</key>
        <string>invalid</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{colors.error.default.hex}}</string>
        </dict>
      </dict>
      <dict>
        <key>scope</key>
        <string>invalid.deprecated</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{colors.yellow.default.hex}}</string>
          <key>fontStyle</key>
          <string>italic</string>
        </dict>
      </dict>
    </array>
  </dict>
</plist>
