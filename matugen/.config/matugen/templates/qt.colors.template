# The palette of every Qt app, set by qt5ct and qt6ct, and the colors KDE apps read
# beyond it (selection, links, positive and negative text). matugen writes it from
# ~/.config/matugen/templates/qt.colors.template, with the same roles as GTK's.
[ColorEffects:Disabled]
Color=255,255,255
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=255,255,255
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

