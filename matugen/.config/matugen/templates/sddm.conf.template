# The login screen's colors. matugen writes them from
# ~/.config/matugen/templates/sddm.conf.template, and wallpaperctl.sh hands them to the
# login screen's helper with the rest of the desktop's look.
crust={{colors.surface_container_lowest.default.hex}}
base={{colors.surface.default.hex}}
primary={{colors.primary.default.hex}}
secondary={{colors.secondary.default.hex}}
red={{colors.error.default.hex}}
