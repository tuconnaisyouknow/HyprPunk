/* The colors of the HyprPunk GTK 3 theme. matugen writes them from
 * ~/.config/matugen/templates/gtk3.css.template, so change them there: each Adwaita
 * tone gets the base's tone at the same depth, the accent is the primary and text
 * a soft shade of it (on_surface), so an app takes the accent's color the way Mocha's
 * lavender sits by its mauve. gtk4.css.template gives GTK 4 the same ones. */

@define-color accent_bg_color {{colors.primary.default.hex}};
@define-color accent_fg_color {{colors.on_primary.default.hex}};
@define-color accent_color {{colors.primary.default.hex}};

@define-color destructive_bg_color {{colors.error.default.hex}};
@define-color destructive_fg_color {{colors.on_error.default.hex}};
@define-color destructive_color {{colors.error.default.hex}};

@define-color success_bg_color {{colors.green.default.hex}};
@define-color success_fg_color {{colors.on_green.default.hex}};
@define-color success_color {{colors.green.default.hex}};

@define-color warning_bg_color {{colors.yellow.default.hex}};
@define-color warning_fg_color {{colors.on_yellow.default.hex}};
@define-color warning_color {{colors.yellow.default.hex}};

@define-color error_bg_color {{colors.error.default.hex}};
@define-color error_fg_color {{colors.on_error.default.hex}};
@define-color error_color {{colors.error.default.hex}};

/* Content sits deepest, the window above it, bars, sidebars and cards above that */
@define-color view_bg_color {{colors.surface_container_low.default.hex}};
@define-color view_fg_color {{colors.on_surface.default.hex}};

@define-color window_bg_color {{colors.surface.default.hex}};
@define-color window_fg_color {{colors.on_surface.default.hex}};

@define-color headerbar_bg_color {{colors.surface_container.default.hex}};
@define-color headerbar_fg_color {{colors.on_surface.default.hex}};
@define-color headerbar_border_color {{colors.on_surface.default.hex}};
@define-color headerbar_backdrop_color @window_bg_color;
@define-color headerbar_shade_color {{colors.shadow.default.rgba | set_alpha: 0.36}};
@define-color headerbar_darker_shade_color {{colors.shadow.default.rgba | set_alpha: 0.9}};

@define-color sidebar_bg_color {{colors.surface_container.default.hex}};
@define-color sidebar_fg_color {{colors.on_surface.default.hex}};
@define-color sidebar_backdrop_color {{colors.surface.default.hex}};
@define-color sidebar_shade_color {{colors.shadow.default.rgba | set_alpha: 0.25}};
@define-color sidebar_border_color {{colors.shadow.default.rgba | set_alpha: 0.36}};

@define-color card_bg_color {{colors.surface_container.default.hex}};
@define-color card_fg_color {{colors.on_surface.default.hex}};
@define-color card_shade_color {{colors.shadow.default.rgba | set_alpha: 0.36}};

@define-color dialog_bg_color {{colors.surface_container.default.hex}};
@define-color dialog_fg_color {{colors.on_surface.default.hex}};

@define-color popover_bg_color {{colors.surface_container.default.hex}};
@define-color popover_fg_color {{colors.on_surface.default.hex}};
@define-color popover_shade_color {{colors.shadow.default.rgba | set_alpha: 0.25}};

@define-color thumbnail_bg_color {{colors.surface_container_high.default.hex}};
@define-color thumbnail_fg_color {{colors.on_surface.default.hex}};

@define-color shade_color {{colors.shadow.default.rgba | set_alpha: 0.25}};
@define-color scrollbar_outline_color {{colors.shadow.default.rgba | set_alpha: 0.95}};
