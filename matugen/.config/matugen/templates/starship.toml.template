# The prompt you see in every terminal, drawn by Starship once .zshrc has set it up.
# matugen writes it to ~/.local/state/hyprpunk/starship.toml in the wallpaper's palette,
# and .zshrc points Starship there.

"$schema" = 'https://starship.rs/config-schema.json'

# Give up on scanning a folder after 100 ms, so huge ones don't slow the prompt
scan_timeout = 100

# One line of pills sliding from one color to the next: who you are, where,
# the git state, the project's language and the time. Then the prompt itself.
format = """
[](fg:surface_container)\
$os\
$username\
${custom.local_spacer}\
$hostname\
[](bg:primary fg:surface_container)\
$directory\
[](fg:primary bg:secondary)\
$git_branch\
$git_status\
[](fg:secondary bg:cyan)\
$nodejs\
$php\
$java\
$python\
[](fg:cyan bg:blue)\
$time\
[ ](fg:blue)\
$line_break$character"""

# The palette's roles, by their own names. Error is the fixed red (meanings.json): it
# says the last command failed.
palette = 'hyprpunk'

[palettes.hyprpunk]
primary = "{{colors.primary.default.hex}}"
secondary = "{{colors.secondary.default.hex}}"
error = "{{colors.error.default.hex}}"
red = "{{colors.tone_red.default.hex}}"
green = "{{colors.tone_green.default.hex}}"
cyan = "{{colors.tone_cyan.default.hex}}"
blue = "{{colors.tone_blue.default.hex}}"
surface = "{{colors.surface.default.hex}}"
surface_container = "{{colors.surface_container.default.hex}}"

# Who and where: distro icon, user, and the machine's name over SSH only
[os]
disabled = false
style = "bg:surface_container fg:secondary"

[os.symbols]
Windows = "󰍲"
Ubuntu = "󰕈"
SUSE = ""
Raspbian = "󰐿"
Mint = "󰣭"
Macos = ""
Manjaro = ""
Linux = "󰌽"
Gentoo = "󰣨"
Fedora = "󰣛"
Alpine = ""
Amazon = ""
Android = ""
Arch = "󰣇"
Artix = "󰣇"
CentOS = ""
Debian = "󰣚"
Redhat = "󱄛"
RedHatEnterprise = "󱄛"
NixOS = "󱄅"

[username]
show_always = true
style_user = "bg:surface_container fg:secondary"
style_root = "bg:surface_container fg:error"
format = '[ $user]($style)'

# Just a space when you're on your own machine, the hostname takes its place over SSH
[custom.local_spacer]
when = 'test -z "$SSH_CONNECTION$SSH_TTY$SSH_CLIENT"'
format = '[ ](bg:surface_container fg:secondary)'

[hostname]
ssh_only = true
ssh_symbol = "󰢹 "
format = "[@$hostname ](bg:surface_container fg:secondary)[$ssh_symbol](bg:surface_container fg:secondary)"

# The last three folders, the usual ones shown as icons
[directory]
style = "fg:surface bg:primary"
format = "[ $path ]($style)"
truncation_length = 3
truncation_symbol = "…/"

[directory.substitutions]
"Documents" = " "
"Downloads" = " "
"GitHub" = " "
"Music" = " "
"Pictures" = " "
"Public" = " "
"Templates" = " "
"Videos" = " "

# Branch, then what's waiting: ? untracked, ! modified, ++ staged, ⇡⇣ ahead or behind
[git_branch]
symbol = ""
style = "bg:secondary"
format = '[[ $symbol $branch ](fg:surface bg:secondary)]($style)'

[git_status]
style = "bg:secondary"
format = '[[($all_status$ahead_behind )](fg:surface bg:secondary)]($style)'
up_to_date = '[ ✓](bg:secondary fg:surface)'
untracked = '[?\($count\)](bg:secondary fg:surface)'
stashed = '[\$](bg:secondary fg:surface)'
modified = '[!\($count\)](bg:secondary fg:surface)'
renamed = '[»\($count\)](bg:secondary fg:surface)'
deleted = '[✘\($count\)](bg:secondary fg:surface)'
staged = '[++\($count\)](bg:secondary fg:surface)'
ahead = '[⇡\(${count}\)](bg:secondary fg:surface)'
diverged = '⇕[\[](bg:secondary fg:surface)[⇡\(${ahead_count}\)](bg:secondary fg:surface)[⇣\(${behind_count}\)](bg:secondary fg:surface)[\]](bg:secondary fg:surface)'
behind = '[⇣\(${count}\)](bg:secondary fg:surface)'

# The project's language and its version.
# The commented ones are ready to go: uncomment them and add them to the format above.
[nodejs]
symbol = ""
style = "bg:cyan"
format = '[[ $symbol( $version) ](fg:surface bg:cyan)]($style)'

#[c]
#symbol = " "
#style = "bg:cyan"
#format = '[[ $symbol( $version) ](fg:surface bg:cyan)]($style)'

#[rust]
#symbol = ""
#style = "bg:cyan"
#format = '[[ $symbol( $version) ](fg:surface bg:cyan)]($style)'

#[golang]
#symbol = ""
#style = "bg:cyan"
#format = '[[ $symbol( $version) ](fg:surface bg:cyan)]($style)'

[php]
symbol = ""
style = "bg:cyan"
format = '[[ $symbol( $version) ](fg:surface bg:cyan)]($style)'

[java]
symbol = " "
style = "bg:cyan"
format = '[[ $symbol( $version) ](fg:surface bg:cyan)]($style)'

#[kotlin]
#symbol = ""
#style = "bg:cyan"
#format = '[[ $symbol( $version) ](fg:surface bg:cyan)]($style)'

#[haskell]
#symbol = ""
#style = "bg:cyan"
#format = '[[ $symbol( $version) ](fg:surface bg:cyan)]($style)'

[python]
symbol = ""
style = "bg:cyan"
format = '[[ $symbol( $version) ](fg:surface bg:cyan)]($style)'

# Hours and minutes
[time]
disabled = false
time_format = "%R"
style = "bg:blue"
format = '[[  $time ](fg:surface bg:blue)]($style)'

[line_break]
disabled = false

# The arrow you type after: the accent, red when the last command failed, other colors in Vim modes
[character]
disabled = false
success_symbol = '[ ](bold fg:primary)'
error_symbol = '[ ](bold fg:error)'
vimcmd_symbol = '[ ](bold fg:primary)'
vimcmd_replace_one_symbol = '[ ](bold fg:red)'
vimcmd_replace_symbol = '[ ](bold fg:red)'
vimcmd_visual_symbol = '[ ](bold fg:green)'

# What a prompt shrinks to once its command has run (see the transient prompt in .zshrc)
[profiles]
transient = """
$character\
"""

rtransient = """
"""
